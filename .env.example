# ---------------------------------------------
# IJCC WEBSITE — Environment Variables Template
# Copy this file to .env.local and fill in all values.
# Never commit .env.local to git.
# ---------------------------------------------

# -- Sanity CMS ---------------------------------
# Get these from https://sanity.io/manage ? your project
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-04-26

# -- Google AI (Chatbot) -------------------------
# Get from https://aistudio.google.com ? Get API Key
GEMINI_API_KEY=
GOOGLE_GENAI_API_KEY=

# -- Firebase -----------------------------------
# Get from https://console.firebase.google.com ? Project Settings ? Your Apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# -- Contact Form (SMTP / Email) -----------------
# Use Gmail App Password or any SMTP provider (e.g. Brevo, Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_FORM_RECEIVER=info@ijcc.in

# -- Razorpay (Membership Payments) -------------
# Get from https://dashboard.razorpay.com ? Settings ? API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# -- Google Sheets (Form Submissions) -----------
# Paste the deployed Google Apps Script Web App URL here
GOOGLE_SHEET_WEB_APP_URL=
